{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile.railway"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "n8n start",
    "restartPolicyMaxRetries": 10,
    "restartPolicyWindowMs": 600000
  },
  "variables": {
    "DB_TYPE": "postgresdb",
    "N8N_HOST": "0.0.0.0",
    "N8N_PORT": "5678",
    "N8N_PROTOCOL": "https",
    "NODE_ENV": "production"
  }
}
